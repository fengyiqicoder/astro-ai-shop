---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ShopView from '../../components/ShopView.astro';
import { sortProducts } from '../../lib/shop';
const products = sortProducts(await getCollection('products'));
---
<Layout title="Shop" description="Every notebook, paper pad, desk piece and binding tool we sell, with prices.">
	<ShopView products={products} heading="The shop" intro="Everything we make and sell. Each item is bought on its own Stripe page, so there is no cart to fill." />
</Layout>
