---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import ShopView from '../../../components/ShopView.astro';
import { store } from '../../../data/store';
import { sortProducts } from '../../../lib/shop';

export async function getStaticPaths() {
	const all = await getCollection('products');
	return store.categories
		.filter((c) => all.some((p) => p.data.category === c.id))
		.map((c) => ({ params: { category: c.id }, props: { label: c.label } }));
}
const { category } = Astro.params;
const { label } = Astro.props;
const products = sortProducts((await getCollection('products')).filter((p) => p.data.category === category));
---
<Layout title={label} description={`${label} from ${store.name}: ${products.map((p) => p.data.title).join(', ')}.`}>
	<ShopView products={products} heading={label} current={category} />
</Layout>
