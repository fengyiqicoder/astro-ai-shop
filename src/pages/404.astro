---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProductGrid from '../components/ProductGrid.astro';
import { url, sortProducts } from '../lib/shop';
const picks = sortProducts(await getCollection('products')).filter((p) => !p.data.soldOut).slice(0, 3);
---
<Layout title="Page not found" noindex>
	<div class="wrap page-head">
		<h1>This page is a blank sheet.</h1>
		<p>Nothing is written here. The product may have moved or sold out. Try <a href={url('/shop/')}>the shop</a> or <a href={url('/')}>the home page</a>.</p>
	</div>
	<div class="wrap">
		<ProductGrid products={picks} />
	</div>
</Layout>
