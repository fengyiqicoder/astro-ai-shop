---
import Layout from '../layouts/Layout.astro';
import { store, policies } from '../data/store';
---
<Layout title="Shipping and returns" description={`Where ${store.name} ships, what it costs, how long it takes and how returns work.`}>
	<div class="wrap page-head">
		<h1>Shipping and returns</h1>
		<p>The short version: flat shipping added at checkout, out in 2 working days, 30 days to return anything unused. The Ask box on every product page answers from this page too.</p>
	</div>
	<div class="wrap policies">
		{policies.map((p) => (
			<section>
				<h2>{p.heading}</h2>
				<p>{p.text}</p>
			</section>
		))}
		<section>
			<h2>How checkout works</h2>
			<p>{store.checkout}</p>
		</section>
	</div>
</Layout>

<style>
	.policies {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0 clamp(2rem, 5vw, 4rem);
		max-width: 64rem;
	}
	section {
		border-top: 2px solid var(--ink);
		padding-block: 1.25rem 2rem;
	}
	h2 {
		font-size: 1.5rem;
	}
	p {
		margin-top: 0.6rem;
		color: var(--ink-soft);
		font-size: 1.0625rem;
	}
	@media (max-width: 44rem) {
		.policies {
			grid-template-columns: 1fr;
		}
	}
</style>
