---
// Stripe sends buyers here after payment. Set this as each Payment Link's "after completion" redirect:
//   https://YOUR-SITE/success/?product=PRODUCT-SLUG&session_id={CHECKOUT_SESSION_ID}
// The page cannot check the payment (there is no backend); the Stripe receipt email is the proof.
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { store } from '../data/store';
import { url } from '../lib/shop';
const names = Object.fromEntries((await getCollection('products')).map((p) => [p.id, p.data.title]));
---
<Layout title="Thank you" description="Your order is placed." noindex>
	<div class="wrap page-head">
		<h1>Thank you. Your order is in.</h1>
		<p data-product-line>Stripe has emailed your receipt. We will email a tracking number on the day your parcel leaves the workshop.</p>
	</div>
	<div class="wrap prose">
		<h2>What happens next</h2>
		<ul>
			<li>In-stock items ship within 2 working days; sewn-to-order notebooks within 5.</li>
			<li>Need to change or cancel? Reply to us within 12 hours at <a href={`mailto:${store.email}`}>{store.email}</a>.</li>
			<li>No receipt after an hour? Check your spam folder, then email us with the address you paid with.</li>
		</ul>
		<p><a class="btn btn--ghost" href={url('/shop/')}>Back to the shop</a></p>
	</div>
	<script type="application/json" id="product-names" set:html={JSON.stringify(names).replace(/</g, '\\u003c')}></script>
	<script>
		// Names the product if the redirect URL carries ?product=<slug>. Text only, never HTML.
		const slug = new URLSearchParams(location.search).get('product');
		const names = JSON.parse(document.getElementById('product-names')?.textContent || '{}');
		const line = document.querySelector('[data-product-line]');
		if (slug && names[slug] && line) line.textContent = `Your ${names[slug]} is paid for. Stripe has emailed your receipt, and we will email a tracking number on the day it leaves the workshop.`;
	</script>
</Layout>
