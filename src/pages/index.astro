---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProductGrid from '../components/ProductGrid.astro';
import Price from '../components/Price.astro';
import { store } from '../data/store';
import { url, sortProducts } from '../lib/shop';

const all = sortProducts(await getCollection('products'));
const featured = all.filter((p) => p.data.featured);
const hero = featured[0] ?? all[0];
const rest = featured.slice(1, 4);
const counts = store.categories.map((c) => ({ ...c, n: all.filter((p) => p.data.category === c.id).length })).filter((c) => c.n);
---
<Layout>
	<section class="wrap hero">
		<div class="hero-copy">
			<h1>Notebooks sewn by hand, sold one at a time.</h1>
			<p class="sub">{store.description}</p>
			<div class="ctas">
				<a class="btn" href={url('/shop/')}>See all {all.length} products</a>
				<a class="btn btn--ghost" href={url('/about/')}>How we make them</a>
			</div>
		</div>
		<a class="hero-item" href={url(`/products/${hero.id}/`)}>
			<img src={url(hero.data.image)} alt={hero.data.imageAlt ?? ''} width="1000" height="1000" fetchpriority="high" />
			<span class="pricetag">
				<span class="pt-title">{hero.data.title}</span>
				<Price amount={hero.data.price} currency={hero.data.currency} class="pt-price" />
			</span>
		</a>
	</section>

	{rest.length > 0 && (
		<section class="wrap block" aria-labelledby="bench">
			<div class="block-head">
				<h2 id="bench">On the bench this month</h2>
				<a href={url('/shop/')}>Everything in the shop</a>
			</div>
			<ProductGrid products={rest} headingLevel="h3" />
		</section>
	)}

	<section class="wrap block" aria-labelledby="buying">
		<h2 id="buying">Buying here</h2>
		<dl class="facts">
			<div><dt>One product, one checkout</dt><dd>Every Buy button opens a Stripe payment page for that product. No account, no cart.</dd></div>
			<div><dt>Out in 2 working days</dt><dd>In-stock items ship within 2 working days; sewn-to-order notebooks within 5.</dd></div>
			<div><dt>30 days to change your mind</dt><dd>Return anything unused for a refund of the product price. <a href={url('/shipping/')}>Shipping and returns</a></dd></div>
		</dl>
	</section>

	<section class="wrap block" aria-labelledby="contents">
		<h2 id="contents">Contents</h2>
		<ol class="toc">
			{counts.map((c) => (
				<li><a href={url(`/shop/category/${c.id}/`)}><span class="toc-name">{c.label}</span><span class="toc-dots" aria-hidden="true"></span><span class="toc-n">{c.n} {c.n === 1 ? 'item' : 'items'}</span></a></li>
			))}
		</ol>
	</section>
</Layout>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
		gap: clamp(2rem, 5vw, 4.5rem);
		align-items: center;
		padding-block: clamp(2rem, 6vw, 5rem);
	}
	h1 {
		font-size: clamp(2.6rem, 6.4vw, 5.6rem);
		line-height: 0.98;
		letter-spacing: -0.035em;
		font-weight: 800;
	}
	.sub {
		margin-top: 1.4rem;
		font-size: clamp(1.05rem, 1.6vw, 1.25rem);
		color: var(--ink-soft);
		max-width: 34rem;
	}
	.ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}
	.hero-item {
		position: relative;
		display: block;
		text-decoration: none;
		margin-bottom: 2.5rem;
	}
	.hero + .block {
		margin-top: clamp(2.5rem, 6vw, 4.5rem);
	}
	.hero-item img {
		width: 100%;
		aspect-ratio: 1;
		background: var(--greyboard);
	}
	/* The price tag: endpaper yellow, hung off the bottom-left corner of the image. */
	.pricetag {
		position: absolute;
		left: clamp(-1.5rem, -2vw, -0.5rem);
		bottom: -2.5rem;
		display: grid;
		gap: 0.35rem;
		background: var(--endpaper);
		color: #161a33;
		padding: 1rem 1.25rem 1.1rem;
		max-width: 80%;
		transform: rotate(-2deg);
		transition: transform 0.25s ease;
	}
	.hero-item:hover .pricetag {
		transform: rotate(0deg) translateY(-4px);
	}
	.pt-title {
		font-weight: 600;
		line-height: 1.2;
	}
	:global(.pt-price) {
		font-size: clamp(3.5rem, 8vw, 6rem);
	}
	.block {
		margin-top: clamp(4rem, 9vw, 7rem);
	}
	.block h2 {
		font-size: clamp(1.8rem, 4vw, 2.75rem);
		margin-bottom: 1.5rem;
	}
	.block-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem 2rem;
	}
	.facts {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0;
		margin: 0;
		border-top: 2px solid var(--ink);
	}
	.facts > div {
		padding: 1.25rem 1.5rem 0 0;
	}
	.facts > div + div {
		border-left: 1px solid var(--greyboard);
		padding-left: 1.5rem;
	}
	dt {
		font: 700 1.25rem/1.2 var(--font-display);
	}
	dd {
		margin: 0.5rem 0 0;
		color: var(--ink-soft);
	}
	.toc {
		list-style: none;
		margin: 0;
		padding: 0;
		max-width: 46rem;
	}
	.toc a {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		padding-block: 0.6rem;
		text-decoration: none;
	}
	.toc-name {
		font: 700 clamp(1.5rem, 3.5vw, 2.25rem)/1.1 var(--font-display);
		letter-spacing: -0.02em;
	}
	.toc a:hover .toc-name {
		color: var(--cloth);
	}
	.toc-dots {
		flex: 1;
		border-bottom: 3px dotted var(--greyboard);
		transform: translateY(-0.3em);
	}
	.toc-n {
		color: var(--ink-soft);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	@media (max-width: 52rem) {
		.hero {
			grid-template-columns: 1fr;
		}
		.pricetag {
			left: 0.75rem;
		}
		.facts {
			grid-template-columns: 1fr;
		}
		.facts > div,
		.facts > div + div {
			border-left: 0;
			padding: 1.1rem 0;
			border-bottom: 1px solid var(--greyboard);
		}
	}
</style>
