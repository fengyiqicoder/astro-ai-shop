---
import Layout from '../layouts/Layout.astro';
import { store } from '../data/store';
import { url } from '../lib/shop';
---
<Layout title="Contact" description={`Email ${store.name} about an order, a product or a return.`}>
	<div class="wrap page-head">
		<h1>Write to us.</h1>
		<p>{store.hours}</p>
	</div>
	<div class="wrap contact">
		<a class="mail" href={`mailto:${store.email}`}>{store.email}</a>
		<dl>
			<div>
				<dt>About an order</dt>
				<dd>Send it from the email address you paid with and include the product name. The Stripe receipt in your inbox has everything else we need.</dd>
			</div>
			<div>
				<dt>About a product</dt>
				<dd>Every product page has an Ask box that answers from the page itself. If the page does not cover it, email us and we will add the answer to the page.</dd>
			</div>
			<div>
				<dt>Returns and damaged parcels</dt>
				<dd>Read <a href={url('/shipping/')}>shipping and returns</a> first, then email us with a photo if something arrived damaged.</dd>
			</div>
			<div>
				<dt>Workshop</dt>
				<dd>{store.location}. We do not have a shop front, so we cannot take visitors or collections.</dd>
			</div>
		</dl>
	</div>
</Layout>

<style>
	.mail {
		display: inline-block;
		font: 700 clamp(1.6rem, 5.5vw, 3.5rem)/1.1 var(--font-display);
		letter-spacing: -0.03em;
		color: var(--cloth);
		text-decoration-thickness: 3px;
		text-decoration-color: var(--thread);
		word-break: break-word;
	}
	dl {
		margin: 3rem 0 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0 3rem;
		max-width: 60rem;
	}
	dl div {
		border-top: 1px solid var(--greyboard);
		padding-block: 1.1rem 1.5rem;
	}
	dt {
		font: 700 1.2rem/1.2 var(--font-display);
	}
	dd {
		margin: 0.45rem 0 0;
		color: var(--ink-soft);
	}
	@media (max-width: 40rem) {
		dl {
			grid-template-columns: 1fr;
		}
	}
</style>
