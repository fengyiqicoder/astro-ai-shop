---
import { getCollection } from 'astro:content';
import type { Product } from '../lib/shop';
import { url } from '../lib/shop';
import { store } from '../data/store';
import ProductGrid from './ProductGrid.astro';
interface Props {
	products: Product[];
	heading: string;
	intro?: string;
	current?: string;
}
const { products, heading, intro, current } = Astro.props;
const all = await getCollection('products');
const cats = store.categories.filter((c) => all.some((p) => p.data.category === c.id));
---
<div class="wrap page-head">
	<h1>{heading}</h1>
	{intro && <p>{intro}</p>}
</div>
<div class="wrap">
	<nav class="filters" aria-label="Categories">
		<a href={url('/shop/')} aria-current={!current ? 'page' : undefined}>All <span>{all.length}</span></a>
		{cats.map((c) => (
			<a href={url(`/shop/category/${c.id}/`)} aria-current={current === c.id ? 'page' : undefined}>{c.label} <span>{all.filter((p) => p.data.category === c.id).length}</span></a>
		))}
	</nav>
	<ProductGrid products={products} />
</div>

<style>
	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1.5rem;
	}
	.filters a {
		display: inline-flex;
		gap: 0.45rem;
		align-items: baseline;
		padding: 0.5rem 0.9rem;
		border: 2px solid var(--greyboard);
		text-decoration: none;
		font-weight: 600;
	}
	.filters a:hover {
		border-color: var(--ink);
	}
	.filters a span {
		font-weight: 400;
		color: var(--ink-soft);
		font-variant-numeric: tabular-nums;
	}
	.filters a[aria-current='page'] {
		background: var(--ink);
		border-color: var(--ink);
		color: var(--blotter);
	}
	.filters a[aria-current='page'] span {
		color: inherit;
		opacity: 0.75;
	}
</style>
