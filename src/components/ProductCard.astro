---
import type { Product } from '../lib/shop';
import { url, categoryLabel } from '../lib/shop';
import Price from './Price.astro';
interface Props {
	product: Product;
	/** The first cards on a page load eagerly so the largest image is not lazy. */
	eager?: boolean;
	headingLevel?: 'h2' | 'h3';
}
const { product, eager = false, headingLevel = 'h2' } = Astro.props;
const d = product.data;
const H = headingLevel;
---
<article class:list={['card', { 'is-soldout': d.soldOut }]}>
	<a class="hit" href={url(`/products/${product.id}/`)}>
		<span class="well">
			<img src={url(d.image)} alt={d.imageAlt ?? ''} width="1000" height="1000" loading={eager ? 'eager' : 'lazy'} decoding="async" />
			{d.badge && !d.soldOut && <span class="tag badge">{d.badge}</span>}
			{d.soldOut && <span class="soldout">Sold out</span>}
		</span>
		<H class="title">{d.title}</H>
		<span class="row">
			<Price amount={d.price} currency={d.currency} class="card-price" />
			<span class="meta">{d.soldOut ? 'Sold out' : categoryLabel(d.category)}</span>
		</span>
	</a>
</article>

<style>
	/* Ruled like a ledger: a hairline to the right and below each tile, no floating cards. */
	.card {
		min-width: 0;
		box-shadow: inset -1px 0 0 var(--greyboard), inset 0 -1px 0 var(--greyboard);
	}
	.hit {
		display: flex;
		flex-direction: column;
		height: 100%;
		padding: clamp(0.75rem, 2vw, 1.25rem);
		text-decoration: none;
	}
	.hit:focus-visible {
		outline-offset: -3px;
	}
	.well {
		position: relative;
		display: block;
		overflow: hidden;
		background: var(--greyboard);
	}
	.well img {
		width: 100%;
		aspect-ratio: 1;
		object-fit: cover;
		transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	.hit:hover .well img {
		transform: scale(1.035) rotate(-0.6deg);
	}
	.badge {
		position: absolute;
		left: 0.75rem;
		top: 0.75rem;
	}
	.soldout {
		position: absolute;
		inset: auto 0 1.25rem 0;
		background: var(--thread);
		color: #fff;
		font: 700 0.95rem/1 var(--font-body);
		padding: 0.6rem 0.9rem;
		width: max-content;
	}
	.is-soldout img {
		filter: grayscale(0.85) contrast(0.9);
		opacity: 0.8;
	}
	.row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-top: auto;
		padding-top: 0.6rem;
	}
	.title {
		margin-top: 1rem;
		font-size: clamp(1.1rem, 1.6vw, 1.3rem);
		line-height: 1.15;
		letter-spacing: -0.01em;
		font-weight: 600;
	}
	.hit:hover .title {
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 0.18em;
	}
	:global(.card-price) {
		font-size: clamp(1.9rem, 3vw, 2.4rem);
	}
	.meta {
		color: var(--ink-soft);
		font-size: 0.9rem;
	}
	.is-soldout :global(.card-price) {
		color: var(--ink-soft);
		text-decoration: line-through;
		text-decoration-color: var(--thread);
		text-decoration-thickness: 3px;
	}
</style>
