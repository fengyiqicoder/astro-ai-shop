---
import type { Product } from '../lib/shop';
import { buyState, formatPrice } from '../lib/shop';
import { store } from '../data/store';
interface Props {
	product: Product;
}
const { product } = Astro.props;
const state = buyState(product);
const price = formatPrice(product.data.price, product.data.currency);
---
<div class="buy" data-state={state.kind}>
	{state.kind === 'buy' && (
		<>
			<a class="btn buy-btn" href={state.href} rel="noopener">Buy for {price}</a>
			<p class="note">{store.checkout} Shipping and any tax are added on the Stripe page.</p>
			{state.mode === 'test' && <p class="note test">Test checkout: use card 4242 4242 4242 4242, any future date and any CVC.</p>}
		</>
	)}
	{state.kind === 'demo' && (
		<>
			<span class="btn buy-btn" role="link" aria-disabled="true">Checkout not connected yet</span>
			<p class="note"><strong>Demo store: checkout is not connected yet.</strong> The store owner pastes a Stripe Payment Link into this product's file to switch it on (<a href="https://github.com/fengyiqicoder/astro-ai-shop#set-up-stripe">README: Set up Stripe</a>).</p>
		</>
	)}
	{state.kind === 'soldout' && (
		<>
			<span class="btn buy-btn" role="link" aria-disabled="true">Sold out</span>
			<p class="note">Sold out for now. <a href={`mailto:${store.email}?subject=${encodeURIComponent(`Tell me when ${product.data.title} is back`)}`}>Email us</a> and we will write once when it is back.</p>
		</>
	)}
</div>

<style>
	.buy {
		display: grid;
		gap: 0.75rem;
	}
	.buy-btn {
		width: 100%;
		font-size: 1.15rem;
		min-height: 3.75rem;
	}
	.note {
		font-size: 0.9rem;
		color: var(--ink-soft);
		max-width: 34rem;
	}
	.note strong {
		color: var(--ink);
	}
	.test {
		border-left: 3px solid var(--endpaper);
		padding-left: 0.6rem;
	}
</style>
