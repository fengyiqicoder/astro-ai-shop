---
import type { Product } from '../lib/shop';
import ProductCard from './ProductCard.astro';
interface Props {
	products: Product[];
	headingLevel?: 'h2' | 'h3';
}
const { products, headingLevel } = Astro.props;
---
<div class="grid">
	{products.map((p, i) => <ProductCard product={p} eager={i < 2} headingLevel={headingLevel} />)}
</div>

<style>
	/* Hairline rules between tiles, like a ruled ledger, instead of floating cards. */
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
		border-top: 1px solid var(--greyboard);
		border-left: 1px solid var(--greyboard);
	}
</style>
