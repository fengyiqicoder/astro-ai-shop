---
import { store } from '../data/store';
import { url } from '../lib/shop';
const year = new Date().getFullYear();
---
<footer class="site-footer">
	<div class="wrap grid">
		<div>
			<p class="name">{store.name}</p>
			<p class="soft">{store.tagline}</p>
			<p class="soft">{store.location}</p>
		</div>
		<nav aria-label="Store">
			<ul>
				<li><a href={url('/shop/')}>Shop</a></li>
				<li><a href={url('/about/')}>About</a></li>
				<li><a href={url('/contact/')}>Contact</a></li>
			</ul>
		</nav>
		<nav aria-label="Policies">
			<ul>
				<li><a href={url('/shipping/')}>Shipping and returns</a></li>
				<li><a href={url('/terms/')}>Terms</a></li>
				<li><a href={url('/privacy/')}>Privacy</a></li>
			</ul>
		</nav>
	</div>
	<div class="wrap small">
		<p>&copy; {year} {store.name}. Payments by Stripe. Product answers by <a href="https://onetagai.com/?ref=astro-ai-shop">OneTag AI</a>.</p>
		<p>Theme: <a href="https://github.com/fengyiqicoder/astro-ai-shop">astro-ai-shop</a>, free and MIT licensed.</p>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: clamp(4rem, 10vw, 8rem);
		border-top: 1px solid var(--greyboard);
		padding-block: 2.5rem 2rem;
	}
	.grid {
		display: grid;
		gap: 2rem;
		grid-template-columns: 2fr 1fr 1fr;
	}
	.name {
		font: 700 1.25rem/1.2 var(--font-display);
		margin-bottom: 0.4rem;
	}
	.soft {
		color: var(--ink-soft);
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.35rem;
	}
	.small {
		margin-top: 2.5rem;
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 2rem;
		font-size: 0.875rem;
		color: var(--ink-soft);
	}
	@media (max-width: 40rem) {
		.grid {
			grid-template-columns: 1fr 1fr;
		}
		.grid > div {
			grid-column: 1 / -1;
		}
	}
</style>
