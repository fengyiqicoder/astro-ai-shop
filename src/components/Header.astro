---
import { store } from '../data/store';
import { url } from '../lib/shop';
import DemoNotice from './DemoNotice.astro';
const here = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
---
<DemoNotice />
<header class="site-header">
	<div class="wrap bar">
		<a class="mark" href={url('/')}>
			<span class="mark-word">{store.short}</span>
			<span class="mark-sub">{store.name.replace(store.short, '').trim()}</span>
		</a>
		<nav aria-label="Main">
			<ul>
				{store.nav.map((n) => (
					<li><a href={url(n.href)} aria-current={here.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
				))}
			</ul>
		</nav>
	</div>
	<hr class="stitch" />
</header>

<style>
	.site-header {
		background: var(--blotter);
	}
	.bar {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem 2rem;
		padding-block: 1.1rem 0.9rem;
	}
	.mark {
		display: inline-flex;
		align-items: baseline;
		gap: 0.4rem;
		text-decoration: none;
	}
	.mark-word {
		font: 800 1.9rem/1 var(--font-display);
		letter-spacing: -0.04em;
	}
	.mark-sub {
		font: 500 0.95rem/1 var(--font-display);
		color: var(--ink-soft);
	}
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.4rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	nav a {
		display: inline-block;
		padding-block: 0.3rem;
		text-decoration: none;
		font-weight: 500;
	}
	nav a:hover {
		text-decoration: underline;
	}
	nav a[aria-current='page'] {
		text-decoration: underline;
		text-decoration-color: var(--thread);
		text-decoration-thickness: 3px;
	}
</style>
