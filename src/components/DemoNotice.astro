---
// One line above the header that says how checkout behaves on this build:
// - no real Payment Link yet: a demo store that cannot take money
// - test mode with real test links: which card to use
// - live mode: nothing is shown
import { getCollection } from 'astro:content';
import { buyState, stripeMode, url } from '../lib/shop';
const products = await getCollection('products');
const states = products.map(buyState);
const anyReal = states.some((s) => s.kind === 'buy');
---
{!anyReal && (
	<p class="notice">Demo store: checkout is not connected yet. Nothing here can be bought. <a href="https://github.com/fengyiqicoder/astro-ai-shop#set-up-stripe">How to connect Stripe</a></p>
)}
{anyReal && stripeMode === 'test' && (
	<p class="notice">Test mode: pay with card 4242 4242 4242 4242, any future date, any CVC. No money moves. <a href={url('/shipping/')}>Shipping and returns</a></p>
)}

<style>
	.notice {
		background: var(--ink);
		color: var(--blotter);
		font-size: 0.875rem;
		line-height: 1.4;
		padding: 0.55rem var(--gutter);
		text-align: center;
	}
	.notice a {
		color: inherit;
		font-weight: 600;
		white-space: nowrap;
	}
</style>
