---
import { formatPrice, priceParts } from '../lib/shop';
interface Props {
	amount: number;
	currency?: string;
	class?: string;
}
const { amount, currency, class: cls } = Astro.props;
const { symbol, number } = priceParts(amount, currency);
---
<span class:list={['price', cls]}><span class="sr-only">{formatPrice(amount, currency)}</span><span aria-hidden="true"><span class="sym">{symbol}</span>{number}</span></span>
